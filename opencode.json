{
  "$schema": "https://opencode.ai/config.json",
  "model": "amazon-bedrock/global.moonshotai.kimi-k3",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "task": "allow",
    "external_directory": "deny"
  },
  "mcp": {
    "graft": {
      "type": "local",
      "command": [
        "graft",
        "mcp"
      ],
      "enabled": true
    }
  }
}
